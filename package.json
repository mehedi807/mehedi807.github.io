{
  "name": "next-static-baseline",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out --listen tcp://127.0.0.1:4173 --no-clipboard",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "check:build": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.1",
    "gray-matter": "4.0.3",
    "motion": "14.9.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.6",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.17.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.17.0"
}
